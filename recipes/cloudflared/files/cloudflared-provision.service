# Boot-time (and refresh-driven) oneshot: create/recover tunnel, DNS, Access.
# RemainAfterExit so cloudflared.service can Require= this unit without
# re-running provision on every connector restart. Do not merge into
# cloudflared.service (oneshot vs Type=notify) or into refresh (different
# lifecycle / public API for refresh_after).
[Unit]
Description=Provision Cloudflare Tunnel for this device
Documentation=https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/
After=network-online.target
Wants=network-online.target
Before=cloudflared.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/cloudflared/cloudflared-provision.sh

[Install]
WantedBy=multi-user.target
